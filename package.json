{
  "name": "seelen-stimme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "watch": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check": "npm run typecheck && npm run lint && npm test",
    "localize:extract": "lit-localize extract",
    "localize:build": "lit-localize build",
    "images:optimize": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "@tailwindcss/vite": "^4.1.3",
    "@vaadin/router": "^2.0.0",
    "lit": "^3.2.1",
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8.2",
    "@types/node": "^22.14.0",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-plugin-lit": "^2.1.1",
    "prettier": "^3.7.4",
    "sharp": "^0.34.5",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.2.0",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "ts-lit-plugin": {
      "lit-analyzer": {
        "vscode-css-languageservice": "latest"
      }
    },
    "vite": {
      "rollup": "^4.30.0"
    }
  }
}
